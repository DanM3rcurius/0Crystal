{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Schema",
  "type": "object",
  "properties": {
    "agent_name": { "type": "string" },
    "agent_pubkey": { "type": "string" },
    "wallet_address": { "type": "string" },
    "agent_type": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "genres": {
          "type": "array",
          "items": { "type": "string" }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preferred_protocols": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gallery_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "agent_endpoint": { "type": "string" },
    "description": { "type": "string" }
  },
  "required": ["agent_name", "wallet_address", "agent_type"]
}